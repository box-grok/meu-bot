{
  "manifest_version": 3,
  "name": "meu-bot CRM",
  "description": "O CRM do meu-bot-crm dentro do Gmail: pipelines, boxes e conversas, sem Streak.",
  "version": "0.1.0",
  "key": "",
  "icons": { "16": "icones/crm-16.png", "32": "icones/crm-32.png", "128": "icones/crm-128.png" },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_end" }
  ],
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://mail.google.com/", "http://127.0.0.1/*"],
  "web_accessible_resources": [
    { "resources": ["*.map", "pageWorld.js", "icones/*"], "matches": ["https://mail.google.com/*"] }
  ]
}
