{
  "manifest_version": 3,
  "name": "meu-bot Autenticador",
  "description": "Códigos de dois fatores do meu-bot-crm: os segredos ficam na sua máquina, aqui só aparecem os códigos.",
  "version": "0.1.0",
  "key": "",
  "icons": { "16": "icones/autenticador-16.png", "32": "icones/autenticador-32.png", "128": "icones/autenticador-128.png" },
