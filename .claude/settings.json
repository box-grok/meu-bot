{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/rebuild-auto.sh\"",
            "timeout": 30,
            "statusMessage": "Conferindo se o app precisa ser reempacotado…"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/pr-lembrete.sh\"",
            "timeout": 20,
            "statusMessage": "Conferindo se há trabalho commitado sem PR…"
          }
        ]
      }
    ]
  }
}
