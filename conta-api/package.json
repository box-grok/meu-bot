{
  "name": "conta-api",
  "private": true,
  "type": "module",
  "description": "API da conta meu-bot (Cloudflare Worker + D1) e a página de login (auth.agentesgrok.com)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "wrangler dev --env staging",
    "migrar:staging": "wrangler d1 migrations apply conta-staging --env staging --remote",
    "migrar": "wrangler d1 migrations apply conta --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
